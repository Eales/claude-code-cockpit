{
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/resume-after-rate-limit.ps1\"",
            "asyncRewake": true,
            "timeout": 21600
          }
        ]
      }
    ]
  }
}
